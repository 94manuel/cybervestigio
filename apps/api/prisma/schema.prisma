generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  USER
  SUPERVISOR
  AUDITOR
}

enum ContactStatus {
  NEW
  IN_REVIEW
  ATTENDED
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ContactRequest {
  id        String        @id @default(uuid())
  fullName  String
  email     String
  phone     String?
  company   String?
  service   String
  message   String
  consent   Boolean       @default(false)
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Service {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  icon        String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id              String   @id @default("main")
  companyName     String   @default("CyberVestigio")
  heroTitle       String
  heroDescription String
  contactEmail    String
  contactPhone    String?
  location        String
  updatedAt       DateTime @updatedAt
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  customerClientId String?
  customerName  String
  customerEmail String
  customerPhone String?
  company       String?
  description   String
  lineItems     Json          @default("[]")
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  agreementDiscountApplied Boolean @default(false)
  agreementEntity String?
  agreementDiscountAmount Decimal @default(0) @db.Decimal(12, 2)
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("COP")
  paymentUrl    String
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customerClient Client?      @relation(fields: [customerClientId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([customerClientId])
}

model Client {
  id        String   @id @default(uuid())
  fullName  String
  cedula    String   @unique
  email     String
  phone     String?
  company   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoices  Invoice[]

  @@index([fullName])
}

model BillingService {
  id               String   @id @default(uuid())
  sector           String
  service          String
  scope            String
  recommendedPrice Decimal  @db.Decimal(12, 2)
  priceNote        String?
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sector])
  @@index([active])
}
